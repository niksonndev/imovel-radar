# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
ADMIN_CHAT_ID=123456789

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Postgres/Neon compartilhado (ADR 0005) — a Bot Lambda acessa o banco direto.
# Em dev local aponta para o Postgres do compose (a mesma base do scraper).
# Em produção use a connection string pooled do Neon (host com -pooler).
DATABASE_URL=postgresql+psycopg://postgres:teste123@localhost:5432/imovel_radar

# DynamoDB — estado de conversa serverless (ADR 0006). Em dev (polling) usa
# PicklePersistence; estas vars só são necessárias para a Lambda/webhook.
DYNAMODB_TABLE=imovel-radar-prod-conversation-state
# Drafts de wizard (horas). Carrossel usa CAROUSEL_TTL_HOURS (default 168).
DYNAMODB_TTL_HOURS=4
CAROUSEL_TTL_HOURS=168
SSM_TOKEN_PARAM=/imovel-radar/prod/telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=

# Onboarding em linguagem natural (IA)
ALERT_NL_ENABLED=true
# Opções: mock, openai
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
SSM_OPENAI_PARAM=/imovel-radar/prod/openai_api_key
PUBLIC_SITE_URL=https://imovel-radar.vercel.app
ASSISTANT_MEMORY_TURNS=6
ASSISTANT_MEMORY_TTL_SECONDS=14400
ASSISTANT_MAX_MESSAGE_CHARS=4000
ASSISTANT_FREE_MESSAGES_PER_DAY=50
ASSISTANT_PRO_MESSAGES_PER_DAY=300
ASSISTANT_FREE_AUDIO_PER_DAY=5
ASSISTANT_PRO_AUDIO_PER_DAY=30
ASSISTANT_MAX_AUDIO_SECONDS=120
ASSISTANT_MAX_AUDIO_BYTES=20971520
ASSISTANT_DAILY_TOKEN_ALERT=100000
SUPPORT_URL=
