# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
ADMIN_CHAT_ID=123456789

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Postgres/Neon compartilhado (ADR 0005) — a Bot Lambda acessa o banco direto.
# Em dev local apunta al Postgres del compose (a mesma base do scraper).
DATABASE_URL=postgresql+psycopg://postgres:teste123@localhost:5432/imovel_radar

# DynamoDB — estado de conversa serverless (ADR 0006). Em dev (polling) usa
# PicklePersistence; estas vars só são necessárias para a Lambda/webhook.
DYNAMODB_TABLE=imovel-radar-prod-conversation-state
SSM_TOKEN_PARAM=/imovel-radar/prod/telegram_bot_token