{
  "name": "instagram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts",
    "publish": "tsx src/cli.ts publish",
    "comments:process": "tsx src/cli.ts comments process",
    "analytics:report": "tsx src/cli.ts analytics report",
    "mock:simulate-comment": "tsx src/cli.ts mock comment",
    "tiktok:publish": "tsx src/cli.ts publish --platform tiktok",
    "tiktok:comments": "tsx src/cli.ts comments process --platform tiktok",
    "tiktok:analytics": "tsx src/cli.ts analytics report --platform tiktok",
    "mock:simulate-comment:tiktok": "tsx src/cli.ts mock comment --platform tiktok"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
