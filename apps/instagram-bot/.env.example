# Ambiente de execucao: MOCK ou LIVE
INSTAGRAM_MODE=MOCK
TIKTOK_MODE=MOCK

# Servidor webhook (deploy: só responde comentários)
PORT=3000
META_VERIFY_TOKEN=imovel_radar_verify_token_secret
META_APP_SECRET=

# Meta Graph API (Modo LIVE) — v26.0 é a versão atual da Graph.
# Facebook Login for Business: graph.facebook.com (upload local de Reels via rupload)
# Instagram Login: graph.instagram.com (fotos/vídeos precisam de URL HTTPS pública)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
GRAPH_API_VERSION=v26.0
GRAPH_API_HOST=graph.facebook.com

# TikTok Open API (Modo LIVE)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Telegram Bot para redirecionamento nos comentarios
TELEGRAM_BOT_USERNAME=imovel_radar_bot

# Publicação LOCAL de fotos: a Meta/TikTok baixam o arquivo por HTTPS.
# cloudflared no PATH, ou um túnel (ngrok) apontando para MEDIA_PORT:
# PUBLISH_BASE_URL=https://seu-tunel.ngrok-free.app
# MEDIA_PORT=3847
