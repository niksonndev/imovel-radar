# Ambiente de execucao: MOCK ou LIVE
INSTAGRAM_MODE=MOCK
TIKTOK_MODE=MOCK

# Servidor Webhook
PORT=3000
META_VERIFY_TOKEN=imovel_radar_verify_token_secret
META_APP_SECRET=

# Meta Graph API (Modo LIVE) — v26.0 é a versão atual da Graph.
# Facebook Login for Business: graph.facebook.com
# Instagram Login: graph.instagram.com
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
GRAPH_API_VERSION=v26.0
GRAPH_API_HOST=graph.facebook.com

# TikTok Open API (Modo LIVE)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# LLM / AI Config
# Opcoes: mock, openai, gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Banco de dados Postgres (read-only em listing e market_snapshot)
DATABASE_URL=postgresql://postgres:teste123@localhost:5432/imovel_radar

# Telegram Bot para redirecionamento nos comentarios
TELEGRAM_BOT_USERNAME=imovel_radar_bot
SITE_BASE_URL=https://imovelradar.com.br
