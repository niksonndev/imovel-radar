# Postgres/Neon compartilhado. Aceita postgresql+psycopg:// (mesmo formato do bot Telegram).
DATABASE_URL=postgresql+psycopg://postgres:teste123@localhost:5432/imovel_radar

# Sessão do WhatsApp Web (SQLite). No Render fica no disco /data.
WHATSAPP_SESSION_PATH=/data/whatsapp.db

# Protege GET /pair?token=... (PNG do QR). Vazio desliga a rota.
PAIR_SECRET=troque-este-segredo

# HTTP de saúde e do QR. O Render injeta PORT.
PORT=10000

LOG_LEVEL=INFO

# Linguagem natural. mock não chama a OpenAI.
ALERT_NL_ENABLED=true
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8
OPENAI_API_KEY=
ASSISTANT_MEMORY_TURNS=6
ASSISTANT_MEMORY_TTL_SECONDS=14400
ASSISTANT_MAX_MESSAGE_CHARS=4000
ASSISTANT_FREE_MESSAGES_PER_DAY=50
ASSISTANT_PRO_MESSAGES_PER_DAY=300
ASSISTANT_FREE_AUDIO_PER_DAY=5
ASSISTANT_PRO_AUDIO_PER_DAY=30
ASSISTANT_MAX_AUDIO_SECONDS=120
ASSISTANT_MAX_AUDIO_BYTES=20971520
ASSISTANT_DAILY_TOKEN_ALERT=100000
PUBLIC_SITE_URL=https://imovel-radar.vercel.app
SUPPORT_URL=

# Freemium, iguais ao bot Telegram.
WATCHLIST_FREE_CAP=2
WATCHLIST_PRO_CAP=10
ALERT_FREE_CAP=1
ALERT_PRO_CAP=5
EMAIL_PRO_TRIAL_DAYS=30
SESSION_TTL_HOURS=4
