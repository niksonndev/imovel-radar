# Postgres/Neon compartilhado com o scraper. Aceita postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://postgres:teste123@localhost:5432/imovel_radar

# Sessão do WhatsApp Web (SQLite). Sem disco no free: /data é efêmero, mas o bot
# faz backup/restauração da sessão via Neon (wa_session_backup) — anti re-pair.
# O snapshot é consistente (VACUUM INTO), então sobrevive ao WAL do cliente.
WHATSAPP_SESSION_PATH=/data/whatsapp.db

# Lock consultivo (Postgres) que serializa a sessão: durante um deploy o Render
# pode sobrepor instâncias por alguns segundos e duas conexões com a mesma
# identidade derrubam uma à outra. Segundos de espera antes de desistir e subir
# de qualquer forma (válvula de escape). 0 desliga a espera.
WA_SESSION_LOCK_WAIT_SECONDS=300

# Render injeta RENDER_EXTERNAL_URL automaticamente (URL pública do service);
# o bot usa /health pra se auto-pingar (keep-alive do free). Sem essa env, desliga.
RENDER_EXTERNAL_URL=

# Protege GET /pair?token=... (PNG do QR). Vazio desliga a rota.
PAIR_SECRET=troque-este-segredo

# HTTP de saúde e do QR. O Render injeta PORT.
PORT=10000

LOG_LEVEL=INFO

# Linguagem natural. mock não chama a OpenAI.
ALERT_NL_ENABLED=true
LLM_PROVIDER=mock
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=8
OPENAI_API_KEY=
ASSISTANT_MEMORY_TURNS=6
ASSISTANT_MEMORY_TTL_SECONDS=14400
ASSISTANT_MAX_MESSAGE_CHARS=4000
ASSISTANT_FREE_MESSAGES_PER_DAY=50
ASSISTANT_PRO_MESSAGES_PER_DAY=300
ASSISTANT_FREE_AUDIO_PER_DAY=8
ASSISTANT_PRO_AUDIO_PER_DAY=30
ASSISTANT_MAX_AUDIO_SECONDS=120
ASSISTANT_MAX_AUDIO_BYTES=20971520
ASSISTANT_DAILY_TOKEN_ALERT=100000
PUBLIC_SITE_URL=https://imovel-radar.vercel.app
SUPPORT_URL=

# Freemium (planos e limites diários).
WATCHLIST_FREE_CAP=2
WATCHLIST_PRO_CAP=10
ALERT_FREE_CAP=1
ALERT_PRO_CAP=5
EMAIL_PRO_TRIAL_DAYS=30

# Cobrança do Radar Pro (Mercado Pago Checkout Pro: Pix e cartão no mesmo link).
# Sem MP_ACCESS_TOKEN o bot mantém o comportamento antigo (trial por e-mail) e
# avisa que pagamento não está disponível — não gera link quebrado.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Mercado Pago > Webhooks). Sem ela toda
# notificação é recusada: não há outro jeito de provar a origem.
MP_WEBHOOK_SECRET=
PRO_MENSAL_CENTS=1990
PRO_MENSAL_DAYS=30
PRO_SEMESTRAL_CENTS=9999
PRO_SEMESTRAL_DAYS=180
SESSION_TTL_HOURS=4
