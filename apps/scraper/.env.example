# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Porta do servidor FastAPI
API_PORT=8000

# Banco de dados Postgres (obrigatório). Default em config.py aponta para o
# container local de desenvolvimento (pg-local); em produção use a URL do Neon.
DATABASE_URL=postgresql+psycopg://postgres:teste123@localhost:5432/imovel_radar

# Coleta agendada: horário local diário (padrão 08:00) no fuso IANA (padrão Maceió)
SCRAPE_CRON_HOUR=8
SCRAPE_CRON_MINUTE=0
SCRAPE_TIMEZONE=America/Maceio

# Scraper OLX (opcionais; em branco usam os padrões em config.py)
# OLX_BASE_URL=https://www.olx.com.br
MACEIO_RENT_LISTINGS_URL=https://www.olx.com.br/imoveis/aluguel/estado-al/alagoas/maceio
# OLX_REFERER=https://www.olx.com.br/
# SCRAPER_DELAY_MIN=2.0
# SCRAPER_DELAY_MAX=5.0