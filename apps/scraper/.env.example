# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Porta do servidor FastAPI
API_PORT=8000

# Banco de dados Postgres (obrigatório). Default em config.py aponta para o
# container local de desenvolvimento (pg-local); em produção use a URL do Neon.
DATABASE_URL=postgresql+psycopg://postgres:teste123@localhost:5432/imovel_radar

# Scraper OLX (opcionais; em branco usam os padrões em config.py)
# OLX_BASE_URL=https://www.olx.com.br
MACEIO_RENT_LISTINGS_URL=https://www.olx.com.br/imoveis/aluguel/estado-al/alagoas/maceio
MACEIO_SALE_LISTINGS_URL=https://www.olx.com.br/imoveis/venda/estado-al/alagoas/maceio
RECIFE_RENT_LISTINGS_URL=https://www.olx.com.br/imoveis/aluguel/estado-pe/grande-recife/recife
RECIFE_SALE_LISTINGS_URL=https://www.olx.com.br/imoveis/venda/estado-pe/grande-recife/recife
NATAL_RENT_LISTINGS_URL=https://www.olx.com.br/imoveis/aluguel/estado-rn/rio-grande-do-norte/natal
NATAL_SALE_LISTINGS_URL=https://www.olx.com.br/imoveis/venda/estado-rn/rio-grande-do-norte/natal
